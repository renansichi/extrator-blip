{
  "name": "extrator-blip",
  "version": "1.0.0",
  "description": "Exportador sequencial Blip com manifesto, integridade e retomada",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
