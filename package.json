    "lossless-json": "4.3.3",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  }
}
